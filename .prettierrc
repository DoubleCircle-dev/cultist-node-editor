{
    "plugins": ["prettier-plugin-jsdoc"],
    "jsdocAlignTags": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "printWidth": 160,
    "useTabs": false,
    "singleQuote": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "proseWrap": "never",
    "endOfLine": "lf",
    "operatorPosition": "end",
    "experimentalTernaries": false
}
