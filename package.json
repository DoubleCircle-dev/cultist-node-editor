{
  "name": "cultist-node-editor",
  "displayName": "cultistVue",
  "description": "visible code editor by node for development of the mod about the game <cultist simulator>",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cultist-node-editor.openEditor",
        "title": "打开密教模拟器节点编辑器"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "test:ui": "node --expose-gc node_modules/mocha/bin/mocha.js --timeout 20000 \"test/ui/**/*.test.mjs\"",
    "test:ui:memory": "node --expose-gc test/ui/memory-check.mjs",
    "check:webview": "node scripts/check-webview.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.3.0",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.4.2",
    "prettier-plugin-jsdoc": "^1.8.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qqf-dev/cultist-node-editor"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "weigh-js": "^1.0.2"
  }
}
